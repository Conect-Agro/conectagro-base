# Configuración del servicio de notificaciones
NODE_ENV=production
PORT=5000

# RabbitMQ Configuration
RABBITMQ_URL=amqp://user:password@rabbitmq:5672
RABBITMQ_QUEUE_NAME=low_stock_alerts

# Telegram Bot Configuration  
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Render.com Configuration (solo para producción)
# RENDER_SERVICE_URL será asignada automáticamente por Render
# Ejemplo: https://tu-servicio.onrender.com
RENDER_SERVICE_URL=

# Keep-alive configuration
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL=240000  # 4 minutos en millisegundos